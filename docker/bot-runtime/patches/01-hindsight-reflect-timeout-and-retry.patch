+def _normalize_reflect_fact_types(value: Any) -> List[str] | None:
+    """Fact types the reflect agent may search; ``None`` means "send no field".
+
+    Missing/blank/empty -> the conservative default (``world``/``experience``: no
+    forced observations pass). ``all`` / ``*`` -> ``None``, which keeps the
+    ``fact_types`` field out of the request and restores Hindsight's own default
+    (every type, observations included). A comma-separated string is accepted for
+    parity with the other list settings.
+    """
+    if value is None or not value:
+        return list(_DEFAULT_REFLECT_FACT_TYPES)
+    if isinstance(value, str):
+        text = value.strip()
+        if text.lower() in {"all", "*"}:
+            return None
+        raw: list = text.split(",")
+    elif isinstance(value, (list, tuple)):
+        raw = list(value)
+    else:
+        return list(_DEFAULT_REFLECT_FACT_TYPES)
+    types = [str(item).strip() for item in raw if str(item).strip()]
+    return types or None
+

+# layer left enabled costs a whole extra pass. The observations layer is the expensive
+# one — a recall-like pass over the consolidated observations — while its content stays
+# in the bank and remains reachable through ``recall``. The default therefore asks for
+# world/experience only; set ``reflect_fact_types`` (HINDSIGHT_REFLECT_FACT_TYPES) to
+# "observation,world,experience" to bring the layer back, or to "all" to send no filter
+# at all (Hindsight's own default).
+_DEFAULT_REFLECT_FACT_TYPES = ("world", "experience")

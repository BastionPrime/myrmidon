diff --git a/tools/github_broker_context.py b/tools/github_broker_context.py
new file mode 100644
index 0000000..ed67d39
--- /dev/null
+++ b/tools/github_broker_context.py
@@ -0,0 +1,77 @@
+"""Run-scoped GitHub broker capability context (myrmidon G1, CONTAINER-GITHUB-WRITE).
+
+The board's hermes_gateway adapter forwards, per /v1/runs request, the pair
+heartbeat minted for exactly that run: the URL of the Paperclip GitHub
+credential broker and the ``github_credentials`` runtime-tools capability
+token. ``gateway/platforms/api_server_runs.py`` carries the pair on the run
+record and binds it here for the whole turn — contextvars, never the process
+env, because a gateway process serves many concurrent runs in executor
+threads that all share ``os.environ``.
+
+``tools/environments/local.py`` bridges the bound values into the environment
+of every terminal/execute_code child spawned inside the turn, so the image's
+``git`` credential helper and ``gh`` wrapper (which read them and call the
+broker) see them, while a concurrent run without a capability of its own gets
+nothing: the bridge copies only values bound in the CURRENT context, and an
+unset var is stripped, not inherited.
+
+The token is a secret: it never appears in argv, in the session snapshot
+(credential-shaped names are excluded there), or in the process env.
+"""
+
+from __future__ import annotations
+
+from contextvars import ContextVar, Token
+from typing import Any, Callable, Mapping
+
+# (broker_url, capability), or None when the run carries no capability.
+_GITHUB_BROKER: ContextVar[tuple[str, str] | None] = ContextVar("PAPERCLIP_GITHUB_BROKER", default=None)
+
+
+def set_github_broker_vars(broker: Mapping[str, str]) -> tuple[Callable[[], None], Callable[[Any], None]]:
+    """Bind *broker* (``broker_url``/``capability``) for this context.
+
+    Returns ``(marker, reset)`` shaped exactly like the other (token, reset)
+    pairs the API server collects: the ``finally`` block calls
+    ``reset(token)`` for every entry, so ``reset`` must accept and ignore one
+    positional argument (the token is already closed over here).
+    """
+    url = str(broker.get("broker_url") or "").strip()
+    capability = str(broker.get("capability") or "").strip()
+    if not url or not capability:
+        # A partial or malformed pair binds nothing: the run continues without
+        # managed GitHub credentials rather than with a half-usable secret.
+        token: Token[tuple[str, str] | None] | None = None
+    else:
+        token = _GITHUB_BROKER.set((url, capability))
+
+    def reset(_token: Any = None) -> None:
+        # myrmidon(G1): reset to the pre-bind value, not to None — a nested
+        # binding (delegate workers re-running this module's setter under a
+        # copied context) must not clear an outer scope's capability. The
+        # argument is ignored: the real token is closed over (the caller's
+        # `reset(token)` convention passes its own marker back).
+        if token is not None:
+            _GITHUB_BROKER.reset(token)
+
+    return (lambda _marker=None: None), reset
+
+
+def github_broker_env() -> dict[str, str]:
+    """The broker pair as a child-process env fragment, or ``{}`` when unbound.
+
+    Called from the terminal child-env bridge (``local.py``) at spawn time, so
+    each subprocess sees only its own run's values.
+    """
+    bound = _GITHUB_BROKER.get()
+    if bound is None:
+        return {}
+    return {
+        "PAPERCLIP_GITHUB_BROKER_URL": bound[0],
+        "PAPERCLIP_GITHUB_BROKER_TOKEN": bound[1],
+    }
+
+
+def github_broker_bound() -> bool:
+    """True when the current context carries a broker capability."""
+    return _GITHUB_BROKER.get() is not None

+    def _snapshot_excluded_secret_names(self) -> tuple[str, ...]:
+        """Credential-shaped names (``_SNAPSHOT_SECRET_ENV_NAME_RE``) from the env THIS
+        process was handed, kept out of the snapshot. Deliberately not gated on
+        ``_profile_scoped_passthrough`` or on multiplexing: the snapshot file lives in a
+        shared temp dir (one uid for every profile of the container), so run secrets

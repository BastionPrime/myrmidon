diff --git a/tools/environments/base_session_env.py b/tools/environments/base_session_env.py
index e0c095e..5ab6dba 100644
--- a/tools/environments/base_session_env.py
+++ b/tools/environments/base_session_env.py
@@ -31,6 +31,20 @@ _SNAPSHOT_EXCLUDED_ENV_REGEX = (
     "HERMES_CRON_SESSION|HERMES_BROWSER_CONTROL_|HERMES_DELEGATED_CHILD_CONTEXT)")
 _SHELL_ENV_NAME_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
 
+# myrmidon(G1): env whose NAME marks it as a credential (…API_KEY, …_SECRET, …_TOKEN,
+# DATABASE_URL). Such a name is a run secret injected by the harness, not the user's own
+# shell state, and the snapshot file sits in a shared temp dir where every profile of the
+# container runs as one uid — file mode alone separates nothing between co-tenant agents.
+# Dumping those names into the snapshot published a live credential into a file any
+# neighbouring profile can read. Excluding them costs nothing functionally: the values stay
+# in the process env every command inherits from the harness, so the snapshot is never their
+# only source. Pattern-based on purpose — a new *_KEY/*_SECRET run var is covered without
+# touching this file again. Consumed by ``BaseEnvironment._snapshot_excluded_secret_names``.
+_SNAPSHOT_SECRET_ENV_NAME_RE = re.compile(
+    r"SECRET|TOKEN|PASSWORD|PASSWD|CREDENTIAL|PRIVATE_KEY|API_KEY"
+    r"|(^|_)KEY(_|$)|(^|_)URL(_|$)|DSN|CONNECTION_STRING",
+    re.IGNORECASE)
+
 # mktemp template suffix + the shell variable holding the allocated temp path.
 _SNAP_TMP_SUFFIX = ".tmp.XXXXXXXXXX"
 _SNAP_TMP = '"$__hermes_snap_tmp"'

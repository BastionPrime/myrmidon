+# myrmidon(G1): retry a READ that finds the database locked. The write path already waits
+# out a busy database (BEGIN IMMEDIATE, idempotent INSERT OR IGNORE, jittered retry), but the
+# read path used to replay only "disk I/O error". With one persistent gateway, two concurrent
+# runs of the same agent (one writing a turn, the other resuming the session history) made the
+# reader fail with "database is locked". In WAL mode there is exactly one writer at a time, so
+# the fix is to wait for it, not to change the locking: a bounded exponential back-off with
+# jitter on the SAME connection (see _read_retrying_ioerr). A persistent lock exhausts the
+# budget and raises the original error; any other OperationalError is raised at once.
+_READ_LOCKED_MARKERS = ("database is locked", "database is busy")
+_READ_LOCKED_RETRY_ATTEMPTS = 15
+_READ_LOCKED_RETRY_BASE_S = 0.05
+_READ_LOCKED_RETRY_CAP_S = 1.0
 
 

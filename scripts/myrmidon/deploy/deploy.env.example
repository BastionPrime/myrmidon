# Settings for scripts/myrmidon/deploy/{deploy,rollback}.sh. Copy it next to
# your compose files, fill in real values and keep it out of this repository.
# All values below are placeholders.

# Image repository; deploys always pin a digest. deploy.sh accepts only this
# value: only images built by CI are deployed, and there is no setting or flag
# that skips the check (registry, build commit on origin/main or a myr-v* tag).
# The check reads the git clone that holds these scripts, so run them from a
# clone of the repository whose `origin` is github.com/itkadr-git/myrmidon.
MYRMIDON_IMAGE=ghcr.io/itkadr-git/myrmidon

# Compose project: directory, main compose file(s) (colon-separated, relative
# to COMPOSE_DIR) and the server service. The scripts write the image line to
# COMPOSE_OVERRIDE_FILE and pass it after COMPOSE_FILES.
COMPOSE_DIR=/srv/example/myrmidon
COMPOSE_FILES=docker-compose.yml
COMPOSE_OVERRIDE_FILE=docker-compose.myrmidon-image.yml
COMPOSE_SERVICE=server

# Health endpoint as seen from the deploy host.
HEALTH_URL=http://127.0.0.1:3100/api/health
HEALTH_TIMEOUT_SEC=300
# In `authenticated` mode the version is visible only to signed-in callers:
# point this at a file (mode 0600) holding a board API key.
HEALTH_TOKEN_FILE=

# State (previous digest, history) and dumps.
STATE_DIR=/srv/example/myrmidon/.myrmidon-deploy
DUMP_DIR=/srv/example/backups/myrmidon

# Database dump before every deploy. The command runs with DUMP_FILE set and
# must write the dump there; an empty or missing file aborts the deploy.
DUMP_COMMAND='docker compose --project-directory /srv/example/myrmidon exec -T db pg_dump -U example -Fc example > "$DUMP_FILE"'
DUMP_MIN_BYTES=1024
# Used only by rollback.sh --restore-dump. Runs with DUMP_FILE set.
RESTORE_COMMAND='docker compose --project-directory /srv/example/myrmidon exec -T db pg_restore -U example -d example --clean --if-exists < "$DUMP_FILE"'

# Maintenance mode:
#   api   - POST/GET MAINTENANCE_API_URL (the R3 maintenance API, /api/myrmidon/maintenance)
#   hook  - run MAINTENANCE_ENTER_COMMAND / MAINTENANCE_EXIT_COMMAND
#   pause - no maintenance API yet: wait MAINTENANCE_PAUSE_SEC seconds
MAINTENANCE_MODE=pause
MAINTENANCE_API_URL=http://127.0.0.1:3100/api/myrmidon/maintenance
MAINTENANCE_TOKEN_FILE=
# What the window does when the drain timeout passes (api mode):
#   interrupt_and_retry - drain for MAINTENANCE_DRAIN_GRACE_SEC and then
#     interrupt the runs that are still going. Each interrupted run is marked
#     interrupted-by-maintenance and is retried automatically when the window
#     closes, so a planned deploy does not wait for long runs and no task is
#     left blocked.
#   wait - keep admission closed and wait out MAINTENANCE_DRAIN_TIMEOUT_SEC
#     (the behaviour before drain-interrupt).
MAINTENANCE_ON_TIMEOUT=interrupt_and_retry
MAINTENANCE_DRAIN_GRACE_SEC=300
# Only used with MAINTENANCE_ON_TIMEOUT=wait.
MAINTENANCE_DRAIN_TIMEOUT_SEC=1800
MAINTENANCE_ENTER_COMMAND=
MAINTENANCE_EXIT_COMMAND=
MAINTENANCE_PAUSE_SEC=0

# RELEASE-GATE (the 01.10 incident): the board and the release's component
# images (dockergate, fleetd) deploy together. deploy.sh resolves the
# component digests from the same release (the myr-vX.Y.Z tag, else the
# sha-<short> tag of the commit) and refuses a release whose components are
# missing from the registry. Set to none to deploy the board alone (NOT
# recommended for a release; the incident was exactly that split).
MYRMIDON_RELEASE_COMPONENTS=dockergate,fleetd

# Per-component settings. Service and override file default to the component
# name and docker-compose.myrmidon-<component>.yml; override per component:
#   MYR_DOCKERGATE_COMPOSE_SERVICE / MYR_DOCKERGATE_OVERRIDE_FILE
#   MYR_FLEETD_COMPOSE_SERVICE     / MYR_FLEETD_OVERRIDE_FILE
# The health URL is REQUIRED for each component: the deploy must prove the
# component answers after its switch, not just that the file was written.
# dockergate has no HTTP listener; it is probed through its unix socket with
# curl --unix-socket (the /_ping route is allowlisted for GET):
#   MYR_DOCKERGATE_HEALTH_URL='--unix-socket /run/myrmidon-dockergate/engine.sock http://localhost/_ping'
# fleetd serves /v1/bots with a bearer token; a probe of /v1/bots with the
# token file answers 200 only when the service is up:
#   MYR_FLEETD_HEALTH_URL='http://127.0.0.1:8080/v1/bots -H "Authorization: Bearer <token>"'
# The value is passed to curl verbatim after the URL, so extra curl arguments
# ride along; quotes keep it one word in the settings file.
MYR_DOCKERGATE_HEALTH_URL=
MYR_FLEETD_HEALTH_URL=

# Post-deploy smoke (RELEASE-GATE): after the deploy, within the timeout at
# least one bot container of this company must re-apply (its container is
# running again); otherwise the deploy reports DEGRADED with the rollback
# commands. Empty company disables the smoke with a warning (not for a
# release: the smoke is the whole point).
MYRMIDON_DEPLOY_SMOKE=1
MYRMIDON_DEPLOY_SMOKE_COMPANY=
MYRMIDON_DEPLOY_SMOKE_AGENT=
MYRMIDON_DEPLOY_SMOKE_TIMEOUT_SEC=300
MYRMIDON_DEPLOY_SMOKE_INTERVAL_SEC=10

# Host executor for deploys started from the board interface (R5-A).
# deploy-from-job.sh polls the board, waits for the maintenance window and
# runs deploy.sh for the job digest, reporting the outcome as
# $STATE_DIR/job-<id>.json (mount that directory read-only into the board
# container as MYRMIDON_DEPLOY_REPORTS_DIR). A board API key file is required
# in `authenticated` mode; the same file as HEALTH_TOKEN_FILE works.
BOARD_API_URL=http://127.0.0.1:3100/api
BOARD_TOKEN_FILE=

# Automatic rollback by health (R5-C). When a deploy started from the board
# fails its health check, the executor immediately runs rollback.sh to the
# image deploy.sh remembered before the switch (the locally known previous
# image) and reports rolled-back / rollback-failed to the board. 1 is the
# default; 0 keeps the manual contract (health-failed, the maintenance window
# stays on, the operator rolls back by hand). The board side of the same
# switch is MYRMIDON_DEPLOY_AUTO_ROLLBACK; both must agree for a consistent
# job view.
AUTO_ROLLBACK=1

# How to count runs in progress. Empty with MAINTENANCE_MODE=api: read
# instance.runningRuns from the maintenance API. Must print a number.
RUNNING_RUNS_COMMAND=
RUNS_WAIT_TIMEOUT_SEC=1800
POLL_INTERVAL_SEC=5
